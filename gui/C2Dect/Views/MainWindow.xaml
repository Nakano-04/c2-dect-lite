<Window x:Class="C2Dect.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:C2Dect.Converters"
        xmlns:localVM="clr-namespace:C2Dect.ViewModels"
        xmlns:localViews="clr-namespace:C2Dect.Views"
        Title="C2-DECT Lite 2.0 - Operator Console" Height="900" Width="1400"
        Icon="../Assets/c2-icon.ico"
        WindowStartupLocation="CenterScreen"
        Background="#0c0e14"
        Loaded="Window_Loaded"
        FontFamily="Segoe UI">
    <Window.InputBindings>
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding RefreshAllCommand}"/>
        <KeyBinding Key="L" Modifiers="Ctrl" Command="{Binding ClearConsoleCommand}"/>
        <KeyBinding Key="F1" Command="{Binding SendCommandCommand}" CommandParameter="help"/>
    </Window.InputBindings>
    <Window.Resources>
        <local:StringToBrushConverter x:Key="ColorToBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:NullToVisibilityConverter x:Key="NullToVisConverter"/>
        <local:ProtectionTextConverter x:Key="ProtectionText"/>

        <!-- View templates -->
        <DataTemplate DataType="{x:Type localVM:LootViewModel}">
            <localViews:LootView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type localVM:ProfilesViewModel}">
            <localViews:ProfilesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type localVM:ScriptMarketplaceViewModel}">
            <localViews:ScriptMarketplaceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type localVM:AdminViewModel}">
            <localViews:AdminView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type localVM:AuditViewModel}">
            <localViews:AuditView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type localVM:ModuleInactiveViewModel}">
            <localViews:ModuleInactiveView/>
        </DataTemplate>

        <!-- Nav button -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6a7080"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="8,1">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#161a24"/>
                                <Setter Property="Foreground" Value="#e0e0e0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action button -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick command pill: larger touch targets for ops use -->
        <Style x:Key="QuickBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- ===== SIDEBAR ===== -->
        <Border Grid.Column="0" Background="#0c0e14" BorderBrush="#1a1e28"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Margin="20,20,20,20">
                    <TextBlock Text="C2-DECT LITE" FontSize="21" FontWeight="Bold"
                               Foreground="#00e676" FontFamily="Consolas"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Ellipse Width="7" Height="7" Fill="#00c853" Margin="0,0,6,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentOperator, StringFormat='Operator: {0}'}"
                                   FontSize="11" Foreground="#4a5060"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation grouped by attack phase. Single neutral palette:
                     default #6a7080, destructive red #ff5252, elevated amber #d4a017.
                     Green accent reserved for active/selected only.
                     Edicion Lite: los modulos que no se implementan siguen en el
                     menu, pero su panel explica que no estan disponibles.
                     Va dentro de un ScrollViewer: si no, las secciones de abajo
                     (GOVERNANCE) quedan fuera de la ventana. -->
                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Expander Header="OPERATE" IsExpanded="True" Foreground="#e0e0e0" FontSize="10" FontWeight="Bold" Margin="8,0,8,0" Background="Transparent" BorderThickness="0">
                        <StackPanel Margin="0,4,0,0">
                            <Button Content="  Sessions" Command="{Binding DataContext.NavigateToSessionsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource NavBtn}" FontWeight="SemiBold" Foreground="#e0e0e0"/>
                            <Button Content="  Listeners" Command="{Binding DataContext.NavigateToModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="listeners" Style="{StaticResource NavBtn}"/>
                            <Button Content="  Payloads" Command="{Binding DataContext.NavigateToModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="payloads" Style="{StaticResource NavBtn}"/>
                            <Button Content="  Payload Builder" Command="{Binding DataContext.NavigateToModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="builder" Style="{StaticResource NavBtn}" Foreground="#8a93a8"/>
                            <Button Content="  Loot" Command="{Binding DataContext.NavigateToLootCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource NavBtn}" Foreground="#e0e0e0"/>
                            <Button Content="  Profiles" Command="{Binding DataContext.NavigateToProfilesCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource NavBtn}" Foreground="#e0e0e0"/>
                        </StackPanel>
                    </Expander>
                    <Expander Header="EXECUTION" IsExpanded="True" Foreground="#8a93a8" FontSize="10" FontWeight="Bold" Margin="8,8,8,0" Background="Transparent" BorderThickness="0">
                        <StackPanel Margin="0,4,0,0">
                            <Button Content="  Implant Config" Command="{Binding DataContext.NavigateToModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="implant-config" Style="{StaticResource NavBtn}" Foreground="#8a93a8"/>
                        </StackPanel>
                    </Expander>
                    <Expander Header="ELEVATE  ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¢  IMPACT" IsExpanded="True" Foreground="#8a93a8" FontSize="10" FontWeight="Bold" Margin="8,8,8,0" Background="Transparent" BorderThickness="0">
                        <StackPanel Margin="0,4,0,0">
                            <Button Content="  Admin" Command="{Binding DataContext.NavigateToAdminCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource NavBtn}" FontWeight="Bold" Foreground="#e0e0e0"/>
                        </StackPanel>
                    </Expander>
                    <Expander Header="RESEARCH" IsExpanded="True" Foreground="#8a93a8" FontSize="10" FontWeight="Bold" Margin="8,8,8,0" Background="Transparent" BorderThickness="0">
                        <StackPanel Margin="0,4,0,0">
                            <Button Content="  Vulnerabilities" Command="{Binding DataContext.NavigateToModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="dashboard" Style="{StaticResource NavBtn}"/>
                            <Button Content="  Vuln Scan (PC)" Command="{Binding DataContext.NavigateToModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="vuln-scan" Style="{StaticResource NavBtn}"/>
                            <Button Content="  Hunting NVD" Command="{Binding DataContext.NavigateToModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="hunting-nvd" Style="{StaticResource NavBtn}"/>
                            <Button Content="  Recon (Go)" Command="{Binding DataContext.NavigateToModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="recon-go" Style="{StaticResource NavBtn}"/>
                            <Button Content="  Segment Map" Command="{Binding DataContext.NavigateToModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="segment-map" Style="{StaticResource NavBtn}"/>
                            <Button Content="  IA Copilot" Command="{Binding DataContext.NavigateToModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="ai-copilot" Style="{StaticResource NavBtn}"/>
                            <Button Content="  Script Market" Command="{Binding DataContext.NavigateToScriptMarketplaceCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource NavBtn}" Foreground="#e0e0e0" FontWeight="SemiBold" ToolTip="Marketplace de paquetes firmados: publicar, listar e instalar. Es el unico modulo funcional de la edicion Lite."/>
                            <Button Content="  Lethal Script" Command="{Binding DataContext.NavigateToLethalScriptCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource NavBtn}" Foreground="#d4a017" FontWeight="SemiBold" ToolTip="Editor y depurador de scripts: snippets, validacion estatica, firma del servidor, envio y salida del agente."/>
                            <Button Content="  Lethal Script Docs" Command="{Binding DataContext.NavigateToLethalScriptDocsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource NavBtn}" ToolTip="Referencia del scripting: formato, superficie c2.*, limites del sandbox y tecnicas que cubren las ordenes."/>
                        </StackPanel>
                    </Expander>
                    <Expander Header="TOOLS" IsExpanded="False" Foreground="#8a93a8" FontSize="10" FontWeight="Bold" Margin="8,8,8,0" Background="Transparent" BorderThickness="0">
                        <StackPanel Margin="0,4,0,0">
                            <Button Content="  Remote Desktop" Command="{Binding DataContext.NavigateToModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="remote-desktop" Style="{StaticResource NavBtn}"/>
                            <Button Content="  File Manager" Command="{Binding DataContext.NavigateToModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="file-manager" Style="{StaticResource NavBtn}"/>
                            <Button Content="  Dashboard" Command="{Binding DataContext.NavigateToModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="dashboard" Style="{StaticResource NavBtn}"/>
                            <Button Content="  Executive Summary" Command="{Binding DataContext.NavigateToModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="executive" Style="{StaticResource NavBtn}"/>
                            <Button Content="  Recon + Vulns" Command="{Binding DataContext.NavigateToModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="recon-vulns" Style="{StaticResource NavBtn}"/>
                            <Button Content="  Operations" Command="{Binding DataContext.NavigateToModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="operations" Style="{StaticResource NavBtn}"/>
                        </StackPanel>
                    </Expander>
                    <!-- Paneles de la API Python (FastAPI :8001): subsistemas de
                         tools/ (recon, fuzzing) mas bounty y research autonomo. -->
                    <Expander Header="0-DAY TOOLING" IsExpanded="True" Foreground="#8a93a8" FontSize="10" FontWeight="Bold" Margin="8,8,8,0" Background="Transparent" BorderThickness="0">
                        <StackPanel Margin="0,4,0,0">
                            <Button Content="  Recon &amp; Fuzzing" Command="{Binding DataContext.NavigateToModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="tooling" Style="{StaticResource NavBtn}"/>
                            <Button Content="  Bounty &amp; Research" Command="{Binding DataContext.NavigateToModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="bounty" Style="{StaticResource NavBtn}"/>
                        </StackPanel>
                    </Expander>
                    <Expander Header="GOVERNANCE" IsExpanded="True" Foreground="#8a93a8" FontSize="10" FontWeight="Bold" Margin="8,8,8,0" Background="Transparent" BorderThickness="0">
                        <StackPanel Margin="0,4,0,0">
                            <Button Content="  Admin" Command="{Binding DataContext.NavigateToAdminCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource NavBtn}" FontWeight="SemiBold" Foreground="#e0e0e0"/>
                            <Button Content="  Audit" Command="{Binding DataContext.NavigateToAuditCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource NavBtn}" Foreground="#e0e0e0" ToolTip="Traza de auditoria encadenada por hash: cada entrada incluye el hash de la anterior."/>
                        </StackPanel>
                    </Expander>
                    <!-- Legend: single accent + destructive reservation -->
                    <TextBlock Text="● neutral  ● active  ● elevated  ● destructive" Foreground="#2a2e3a" FontSize="9" Margin="16,10,8,0" TextWrapping="Wrap" ToolTip="Green = active/selected, amber = elevated privilege, red = destructive. Everything else neutral."/>
                </StackPanel>
                </ScrollViewer>

                <!-- Bottom status -->
                <Border DockPanel.Dock="Bottom" Background="#080a10" Padding="16,12"
                        BorderBrush="#1a1e28" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Active: " FontSize="11" Foreground="#4a5060"/>
                            <TextBlock Text="{Binding ActiveSessions, Mode=OneWay}"
                                       FontSize="11" Foreground="#00c853" FontWeight="Bold"/>
                            <TextBlock Text="  |  Total: " FontSize="11" Foreground="#4a5060"/>
                            <TextBlock Text="{Binding TotalSessions, Mode=OneWay}"
                                       FontSize="11" Foreground="#d4a017"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Operators: " FontSize="11" Foreground="#4a5060"/>
                            <TextBlock Text="{Binding OperatorCount, Mode=OneWay}"
                                       FontSize="11" Foreground="#58a6ff" FontWeight="Bold"/>
                            <TextBlock Text="  |  Tenants: " FontSize="11" Foreground="#4a5060"/>
                            <TextBlock Text="{Binding TenantCount, Mode=OneWay}"
                                       FontSize="11" Foreground="#ff9800" FontWeight="Bold"/>
                            <TextBlock Text="  |  Tenant:" FontSize="11" Foreground="#4a5060" Margin="6,0,0,0"/>
                            <TextBlock Text="{Binding TenantScopeLabel}" FontSize="11" Foreground="#e0e0e0" Margin="4,0,0,0" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TenantAccessNotice}" FontSize="10"
                                   Foreground="#8a6a30" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding TenantFaultReason}" FontSize="10"
                                   Foreground="#ff5252" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Visibility="{Binding TenantScopeFaulted, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="10"
                                   Foreground="#2a2e3a" TextTrimming="CharacterEllipsis"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- ===== MAIN AREA ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="260"/>
            </Grid.RowDefinitions>

            <!-- Toolbar: session click-to-select lives in the table below.
                 Search filters by hostname / IP / user. Hotkeys: Ctrl+R refresh, Ctrl+L clear, F1 help. -->
            <Border Grid.Row="0" Background="#0f1118" Padding="12,8"
                    BorderBrush="#1a1e28" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="ÃƒÂ¢Ã¢â‚¬â€œÃ‚Â¶ Launch Agent"
                            Command="{Binding LaunchAgentCommand}" ToolTip="Launch local agent (Ctrl+Shift+A)"
                            Style="{StaticResource ActionBtn}" Background="#0a2e1a"
                            Foreground="#00e676" FontWeight="Bold" Margin="0,0,10,0"/>
                    <Button Grid.Column="1" Content="ÃƒÂ¢Ã…Â¸Ã‚Â³ Refresh (Ctrl+R)"
                            Command="{Binding RefreshAllCommand}" ToolTip="Refresh sessions + tasks"
                            Style="{StaticResource ActionBtn}" Background="#161a24"
                            Foreground="#6a7080" BorderBrush="#252a36" BorderThickness="1"
                            Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding TenantList}" SelectedItem="{Binding SelectedTenantItem}" DisplayMemberPath="Name" Width="130" Background="#1a1e28" Foreground="#e0e0e0" BorderBrush="#1e2330" BorderThickness="1" Margin="0,0,10,0"
                              IsEnabled="{Binding CanSwitchTenant}"
                              ToolTip="Tenant activo: acota /sessions y /loot vÃƒÆ’Ã‚Â­a ?tenant_id=. Solo role=admin puede cambiarlo - el servidor lo honra ÃƒÆ’Ã‚Âºnicamente si callerIsAdmin (handlers.go:956); para un operador el selector queda fijo en el tenant de su token."/>
                    <TextBox Grid.Column="3" Text="{Binding SessionSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="#12151c" Foreground="#e0e0e0" CaretBrush="#00e676"
                             BorderBrush="#1e2330" BorderThickness="1" Padding="8,6" FontSize="12"
                             VerticalContentAlignment="Center" ToolTip="Filter sessions: hostname, IP, user, ID"/>
                    <TextBlock Grid.Column="4"
                               Text="{Binding SelectedSession.DisplayName, FallbackValue='Select a session (click a row)'}"
                               VerticalAlignment="Center" Foreground="#e0e0e0"
                               FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="5" Text="{Binding StatusText}"
                               VerticalAlignment="Center" Foreground="#3a3f50"
                               FontSize="11"/>
                </Grid>
            </Border>

            <!-- Sessions Table + View Container. Click a row to select (no separate selector).
                 Empty state collapses the grid and shows welcome + listener status. -->
            <Grid Grid.Row="1" Background="#0c0e14">
                <!-- Sessions table (visible when CurrentView is null) -->
                <Border Background="#0c0e14" Visibility="{Binding CurrentView, Converter={StaticResource NullToVisConverter}, FallbackValue=Visible}">
                    <Grid>
                    <DataGrid ItemsSource="{Binding SessionsView}"
                              SelectedItem="{Binding SelectedSession}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Background="#0c0e14" Foreground="#c0c8d8"
                              BorderThickness="0" RowBackground="#0c0e14"
                              AlternatingRowBackground="#11141c"
                              HeadersVisibility="Column" SelectionMode="Single"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1a1e28">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#080a10"/>
                                <Setter Property="Foreground" Value="#5a6070"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderBrush" Value="#1a1e28"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="State" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="LIVE &lt;60s Ãƒâ€šÃ‚Â· SLEEP &lt;5min Ãƒâ€šÃ‚Â· STALE older Ãƒâ€šÃ‚Â· DEAD reported">
                                            <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                                     Fill="{Binding StatusColor, Converter={StaticResource ColorToBrush}}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding StateText, FallbackValue='LIVE'}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{Binding StatusColor, Converter={StaticResource ColorToBrush}}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="85"/>
                            <DataGridTextColumn Header="Host" Binding="{Binding Hostname}" Width="120"/>
                            <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="110"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding PID}" Width="50"/>
                            <DataGridTextColumn Header="Sleep" Binding="{Binding SleepSec, StringFormat='{}{0}s'}" Width="45"/>
                            <DataGridTextColumn Header="Last" Binding="{Binding LastCheckInAgo, FallbackValue='4s ago'}" Width="65"/>
                            <DataGridTextColumn Header="RTT" Binding="{Binding RttMs, StringFormat='{}{0}ms', FallbackValue='38ms'}" Width="55"/>
                            <DataGridTextColumn Header="Tasks" Binding="{Binding TaskCount, FallbackValue='2'}" Width="45"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <!-- Empty state: replaces empty table with welcome + actions -->
                    <Border Background="#0c0e14" Padding="32">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TotalSessions}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                            <TextBlock Text="ÃƒÂ¢Ã¢â‚¬â€Ã‚Â·" Foreground="#2a2e3a" FontSize="36" HorizontalAlignment="Center"/>
                            <TextBlock Text="No sessions yet" Foreground="#e0e0e0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock Text="Launch an agent or check listeners. Use the search above once you have 50+ sessions." Foreground="#5a6070" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,16"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="ÃƒÂ¢Ã¢â‚¬â€œÃ‚Â¶ Launch Agent" Command="{Binding LaunchAgentCommand}" Background="#0a2e1a" Foreground="#00e676" FontWeight="Bold" Padding="16,8" Margin="0,0,8,0" Cursor="Hand"/>
                                <Button Content="ÃƒÂ¢Ã…Â¸Ã‚Â³ Refresh" Command="{Binding RefreshAllCommand}" Background="#161a24" Foreground="#c0c8d8" Padding="16,8" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    </Grid>
                </Border>
                <!-- Current View (replaces sessions table when navigated) -->
                <ContentControl Content="{Binding CurrentView}" Margin="0"/>
            </Grid>

            <!-- Console: syntax colors via ConsoleMessage.Color (green ok / red err / gray info).
                 History with ÃƒÂ¢Ã¢â‚¬Â Ã¢â‚¬Ëœ/ÃƒÂ¢Ã¢â‚¬Â Ã¢â‚¬Å“, Tab complete, Ctrl+L clear, Ctrl+R refresh, F1 help. -->
            <Border Grid.Row="2" Background="#080a10" BorderBrush="#1a1e28"
                    BorderThickness="0,1,0,0">
                <DockPanel>
                    <!-- Console toolbar -->
                    <Border DockPanel.Dock="Top" Background="#0f1118" Padding="12,6"
                            BorderBrush="#1a1e28" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TERMINAL" Foreground="#00e676" FontSize="11" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="ÃƒÂ¢Ã¢â‚¬Â Ã¢â‚¬Ëœ/ÃƒÂ¢Ã¢â‚¬Â Ã¢â‚¬Å“ history Ãƒâ€šÃ‚Â· Tab complete Ãƒâ€šÃ‚Â· Ctrl+L clear Ãƒâ€šÃ‚Â· Ctrl+R refresh" Foreground="#2a2e3a" FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <Button Grid.Column="2" Content="Clear (Ctrl+L)" Click="ClearConsole_Click" Background="Transparent" Foreground="#5a6070" BorderThickness="0" Padding="8,4" Cursor="Hand" FontSize="11"/>
                            <Button Grid.Column="3" Content="Copy all" Click="CopyConsole_Click" Background="Transparent" Foreground="#5a6070" BorderThickness="0" Padding="8,4" Cursor="Hand" FontSize="11"/>
                            <Button Grid.Column="4" Content="Export" Click="ExportLogs_Click" Background="Transparent" Foreground="#5a6070" BorderThickness="0" Padding="8,4" Cursor="Hand" FontSize="11"/>
                        </Grid>
                    </Border>
                    <!-- Input bar -->
                    <Border DockPanel.Dock="Bottom" Background="#0f1118" Padding="8,6"
                            BorderBrush="#1a1e28" BorderThickness="0,1,0,0">
                        <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="CommandInput" Grid.Column="0"
                                     Background="Transparent" Foreground="#00e676"
                                     FontFamily="Consolas" FontSize="13"
                                     BorderThickness="0" Padding="8,4"
                                     KeyDown="CommandInput_KeyDown"
                                     CaretBrush="#00e676"/>
                            <Button Grid.Column="1" Content=" Send" Height="30"
                                    Click="SendCommand_Click"
                                    Style="{StaticResource ActionBtn}"
                                    Background="#0a2e1a" Foreground="#00e676"
                                    Margin="4,0,4,0"/>
                            <Button Grid.Column="2" Content=" ?" Height="30" Width="30"
                                    Click="HelpButton_Click"
                                    Style="{StaticResource ActionBtn}"
                                    Background="#161a24" Foreground="#6a7080"
                                    Margin="0,0,4,0" FontWeight="Bold"/>
                        </Grid>

                        <!-- Autorizacion del operador para ACCIONES DESTRUCTIVAS
                             del plano del agente (elevar privilegios, cifrar,
                             capturar la pantalla...). El servidor la exige: sin
                             esta marca, la tarea no se encola. -->
                        <CheckBox x:Name="CommandConsent" Margin="10,2,0,0"
                                  Content="Confirmo que el objetivo de esta orden esta autorizado"
                                  Foreground="#6a7080" FontSize="11"
                                  IsChecked="{Binding CommandConsentGiven, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>

                    <!-- Console output -->
                    <ScrollViewer x:Name="ConsoleScroller"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="#080a10">
                        <ItemsControl ItemsSource="{Binding ConsoleOutput}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Padding="16,4" FontFamily="Consolas"
                                               FontSize="12"
                                               Foreground="{Binding Color, Converter={StaticResource ColorToBrush}}"
                                               Text="{Binding Content}"
                                               TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== RIGHT PANEL ===== -->
        <Border Grid.Column="2" Background="#0c0e14" BorderBrush="#1a1e28"
                BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,16,16,16">

                    <!-- Quick Commands: search + free input lives in the bottom console.
                     Buttons are 34px targets; type to filter. -->
                    <TextBlock Text="QUICK COMMANDS" FontSize="10" Foreground="#3a3f50"
                               FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBox x:Name="QuickSearch" Background="#12151c" Foreground="#e0e0e0" CaretBrush="#00e676"
                             BorderBrush="#1e2330" BorderThickness="1" Padding="8,6" FontSize="11" Margin="0,0,0,8"
                             ToolTip="Filter quick commands" TextChanged="QuickSearch_TextChanged"/>
                    <StackPanel x:Name="QuickCommandsHost">
                    <WrapPanel Margin="0,0,0,16">
                        <Button Content="whoami" Margin="0,0,4,4" Style="{StaticResource QuickBtn}"
                                Background="#161a24" Foreground="#c0c8d8"
                                BorderBrush="#252a36" Click="QuickCommand_Click"/>
                        <Button Content="hostname" Margin="0,0,4,4"
                                Style="{StaticResource QuickBtn}" Background="#161a24"
                                Foreground="#c0c8d8" BorderBrush="#252a36"
                                Click="QuickCommand_Click"/>
                        <Button Content="uptime" Margin="0,0,4,4"
                                Style="{StaticResource QuickBtn}" Background="#161a24"
                                Foreground="#c0c8d8" BorderBrush="#252a36"
                                Click="QuickCommand_Click"/>
                        <Button Content="ps" Margin="0,0,4,4"
                                Style="{StaticResource QuickBtn}" Background="#161a24"
                                Foreground="#c0c8d8" BorderBrush="#252a36"
                                Click="QuickCommand_Click"/>
                        <Button Content="sysinfo" Margin="0,0,4,4"
                                Style="{StaticResource QuickBtn}" Background="#161a24"
                                Foreground="#c0c8d8" BorderBrush="#252a36"
                                Click="QuickCommand_Click"/>
                        <Button Content="netinfo" Margin="0,0,4,4"
                                Style="{StaticResource QuickBtn}" Background="#161a24"
                                Foreground="#c0c8d8" BorderBrush="#252a36"
                                Click="QuickCommand_Click"/>
                        <Button Content="connections" Margin="0,0,4,4"
                                Style="{StaticResource QuickBtn}" Background="#161a24"
                                Foreground="#c0c8d8" BorderBrush="#252a36"
                                Click="QuickCommand_Click"/>
                        <Button Content="services" Margin="0,0,4,4"
                                Style="{StaticResource QuickBtn}" Background="#161a24"
                                Foreground="#c0c8d8" BorderBrush="#252a36"
                                Click="QuickCommand_Click"/>
                    </WrapPanel>

                    <!-- Remote Control: el agente Lite no implementa captura de
                         pantalla, teclado ni webcam, asi que el bloque no se
                         muestra en esta edicion. -->

                    <!-- File Operations -->
                    <TextBlock Text="FILE OPERATIONS" FontSize="10" Foreground="#3a3f50"
                               FontWeight="Bold" Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,16">
                        <Button Content="ls ." Margin="0,0,4,4"
                                Style="{StaticResource QuickBtn}" Background="#0d2617"
                                Foreground="#00c853" BorderBrush="#145028"
                                Click="QuickCommand_Click"/>
                        <Button Content="stat ." Margin="0,0,4,4"
                                Style="{StaticResource QuickBtn}" Background="#0d2617"
                                Foreground="#00c853" BorderBrush="#145028"
                                Click="QuickCommand_Click"/>
                        <Button Content="find . *.txt" Margin="0,0,4,4"
                                Style="{StaticResource QuickBtn}" Background="#0d2617"
                                Foreground="#00c853" BorderBrush="#145028"
                                Click="QuickCommand_Click"/>
                        <Button Content="hashfile ." Margin="0,0,4,4"
                                Style="{StaticResource QuickBtn}" Background="#0d2617"
                                Foreground="#00c853" BorderBrush="#145028"
                                Click="QuickCommand_Click"/>
                    </WrapPanel>

                    <!-- System Info -->
                    <TextBlock Text="SYSTEM INFO" FontSize="10" Foreground="#3a3f50"
                               FontWeight="Bold" Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,16">
                        <Button Content="sysinfo" Margin="0,0,4,4"
                                Style="{StaticResource QuickBtn}" Background="#1a1508"
                                Foreground="#d4a017" BorderBrush="#3a3010"
                                Click="QuickCommand_Click"/>
                        <Button Content="netinfo" Margin="0,0,4,4"
                                Style="{StaticResource QuickBtn}" Background="#1a1508"
                                Foreground="#d4a017" BorderBrush="#3a3010"
                                Click="QuickCommand_Click"/>
                        <Button Content="ps" Margin="0,0,4,4"
                                Style="{StaticResource QuickBtn}" Background="#1a1508"
                                Foreground="#d4a017" BorderBrush="#3a3010"
                                Click="QuickCommand_Click"/>
                        <Button Content="connections" Margin="0,0,4,4"
                                Style="{StaticResource QuickBtn}" Background="#1a1508"
                                Foreground="#d4a017" BorderBrush="#3a3010"
                                Click="QuickCommand_Click"/>
                        <Button Content="services" Margin="0,0,4,4"
                                Style="{StaticResource QuickBtn}" Background="#1a1508"
                                Foreground="#d4a017" BorderBrush="#3a3010"
                                Click="QuickCommand_Click"/>
                        <Button Content="env" Margin="0,0,4,4"
                                Style="{StaticResource QuickBtn}" Background="#1a1508"
                                Foreground="#d4a017" BorderBrush="#3a3010"
                                Click="QuickCommand_Click"/>
                    </WrapPanel>

                    <!-- Agent Control: destructive red reserved -->
                    <TextBlock Text="AGENT CONTROL" FontSize="10" Foreground="#3a3f50"
                               FontWeight="Bold" Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,16">
                        <Button Content="sleep 5" Margin="0,0,4,4"
                                Style="{StaticResource QuickBtn}" Background="#1a0d0d"
                                Foreground="#ff5252" BorderBrush="#3a1a1a"
                                Click="QuickCommand_Click"/>
                        <Button Content="sleep 30" Margin="0,0,4,4"
                                Style="{StaticResource QuickBtn}" Background="#1a0d0d"
                                Foreground="#ff5252" BorderBrush="#3a1a1a"
                                Click="QuickCommand_Click"/>
                        <Button Content="exit" Margin="0,0,4,4"
                                Style="{StaticResource QuickBtn}" Background="#1a0d0d"
                                Foreground="#ff5252" BorderBrush="#3a1a1a"
                                Click="QuickCommand_Click"/>
                    </WrapPanel>
                    </StackPanel>

                    <Border Height="1" Background="#1a1e28" Margin="0,0,0,16"/>

                    <!-- Session Info -->
                    <TextBlock Text="SESSION INFO" FontSize="10" Foreground="#3a3f50"
                               FontWeight="Bold" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <!-- Placeholder sin sesiÃƒÆ’Ã‚Â³n -->
                        <Border Background="#0a0c12" CornerRadius="6" Padding="16" BorderBrush="#1e2330" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="ÃƒÂ¢Ã¢â‚¬â€Ã‚Â·" Foreground="#2a2e3a" FontSize="22" HorizontalAlignment="Center"/>
                                <TextBlock Text="Waiting for agent connection..." Foreground="#5a6070" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0" FontWeight="SemiBold"/>
                                <TextBlock Text="Launch with 'Launch Agent' or run build/agent.exe" Foreground="#3a3f50" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSession}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <!-- Detalles sesiÃƒÆ’Ã‚Â³n -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSession}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22"/><RowDefinition Height="22"/>
                                <RowDefinition Height="22"/><RowDefinition Height="22"/>
                                <RowDefinition Height="22"/><RowDefinition Height="22"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Host:" Foreground="#4a5060" FontSize="11"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding SelectedSession.Hostname, FallbackValue='-'}"
                                       Foreground="#c0c8d8" FontSize="11"/>

                            <TextBlock Grid.Row="1" Text="User:" Foreground="#4a5060" FontSize="11"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding SelectedSession.Username, FallbackValue='-'}"
                                       Foreground="#c0c8d8" FontSize="11"/>

                            <TextBlock Grid.Row="2" Text="OS:" Foreground="#4a5060" FontSize="11"/>
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{Binding SelectedSession.OS, FallbackValue='-'}"
                                       Foreground="#c0c8d8" FontSize="11"/>

                            <TextBlock Grid.Row="3" Text="PID:" Foreground="#4a5060" FontSize="11"/>
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Text="{Binding SelectedSession.PID, FallbackValue='-'}"
                                       Foreground="#c0c8d8" FontSize="11"/>

                            <TextBlock Grid.Row="4" Text="IP:" Foreground="#4a5060" FontSize="11"/>
                            <TextBlock Grid.Row="4" Grid.Column="1"
                                       Text="{Binding SelectedSession.InternalIp, FallbackValue='-'}"
                                       Foreground="#c0c8d8" FontSize="11"/>

                            <TextBlock Grid.Row="5" Text="Sleep:" Foreground="#4a5060" FontSize="11"/>
                            <TextBlock Grid.Row="5" Grid.Column="1"
                                       Text="{Binding SelectedSession.SleepSec, StringFormat='{}{0}s', FallbackValue='-'}"
                                       Foreground="#c0c8d8" FontSize="11"/>
                        </Grid>
                    </Grid>

                    <Border Height="1" Background="#1a1e28" Margin="0,0,0,16"/>

                    <!-- WORKSPACE (F40): PUT /api/sessions/:id/workspace y
                         GET /api/sessions?workspace= -->
                    <TextBlock Text="WORKSPACE" FontSize="10" Foreground="#3a3f50"
                               FontWeight="Bold" Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding AvailableWorkspaces}"
                              Text="{Binding WorkspaceName, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True" Height="30" Margin="0,0,0,6"
                              Background="#12151c" Foreground="#e0e0e0" BorderBrush="#1e2330" BorderThickness="1"
                              ToolTip="Nombre del workspace [a-z0-9-]{1,32}. El servidor lo guarda como token ws:&lt;nombre&gt; en los tags de la sesiÃƒÆ’Ã‚Â³n."/>
                    <WrapPanel Margin="0,0,0,6">
                        <Button Content="ASIGNAR A SESIÃƒÆ’Ã¢â‚¬Å“N" Command="{Binding ApplyWorkspaceCommand}"
                                Background="#1a1508" Foreground="#d4a017" BorderBrush="#3a3010"
                                BorderThickness="1" Height="30" Padding="10,0" Margin="0,0,6,6" FontSize="11"/>
                        <Button Content="FILTRAR SESIONES" Command="{Binding LoadWorkspaceSessionsCommand}"
                                Background="#0d1a2a" Foreground="#58a6ff" BorderBrush="#1a3050"
                                BorderThickness="1" Height="30" Padding="10,0" Margin="0,0,6,6" FontSize="11"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding WorkspaceStatus}" Foreground="#8aa0ff" FontSize="10"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <ListView ItemsSource="{Binding WorkspaceSessions}" MaxHeight="140"
                              Background="Transparent" Foreground="#c0c8d8" BorderThickness="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="0,2"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" FontSize="11" Foreground="#c0c8d8"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Height="1" Background="#1a1e28" Margin="0,16,0,16"/>

                    <!-- AI Assistant: analyzes terminal output + suggests next command for selected session -->
                    <TextBlock Text="AI ASSISTANT" FontSize="10" Foreground="#8aa0ff"
                               FontWeight="Bold" Margin="0,12,0,8"/>
                    <Border Background="#0a0c12" CornerRadius="6" Padding="8" BorderBrush="#1a1e28" BorderThickness="1" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBox x:Name="AiInput" Background="#12151c" Foreground="#e0e0e0" FontSize="11" FontFamily="Consolas" Padding="6" BorderBrush="#1e2330" BorderThickness="1" Margin="0,0,0,6" ToolTip="Ask: next step, lateral, edr. ANALYZE reads terminal."/>
                            <WrapPanel Margin="0,0,0,0">
                                <Button Content="ASK" Width="70" Height="30" Background="#0a2e1a" Foreground="#00e676" BorderBrush="#00e67640" BorderThickness="1" Click="AiAsk_Click" Margin="0,0,6,6"/>
                                <Button Content="SUGGEST" Width="80" Height="30" Background="#1a1508" Foreground="#d4a017" BorderBrush="#3a3010" BorderThickness="1" Click="AiSuggest_Click" Margin="0,0,6,6"/>
                                <Button Content="ANALYZE TERMINAL" Width="130" Height="30" Background="#0d1a2a" Foreground="#58a6ff" BorderBrush="#1a3050" BorderThickness="1" Click="AiAnalyze_Click" ToolTip="Send last terminal output to assistant"/>
                            </WrapPanel>
                            <TextBox x:Name="AiOutput" Background="Transparent" Foreground="#8aa0ff" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0" Margin="0,6,0,0" MinHeight="60" MaxHeight="120" VerticalScrollBarVisibility="Auto" Text="Assistant ready. Try SUGGEST (session-aware) or ANALYZE TERMINAL."/>
                            <Border x:Name="AiProactiveAlert" Background="#2a1508" CornerRadius="4" Padding="6" Margin="0,6,0,0" BorderBrush="#ff9800" BorderThickness="1" Visibility="Collapsed">
                                <TextBlock x:Name="AiProactiveText" Foreground="#ffab00" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Ellipse x:Name="AiOllamaDot" Width="8" Height="8" Fill="#ff5252" Margin="0,0,6,0"/>
                                <TextBlock x:Name="AiOllamaStatus" Foreground="#4a5060" FontSize="10" Text="Ollama: off"
                                           ToolTip="Ollama = sondeo directo al que usa el asistente de esta caja. IA = estado real del plano que usa la vista IA Copilot (API Python :8001, /api/ia/status): llm hay modelo, heuristico solo reglas locales, sin respuesta la API no contesta."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Tasks -->
                    <TextBlock Text="TASKS" FontSize="10" Foreground="#3a3f50"
                               FontWeight="Bold" Margin="0,0,0,8"/>
                    <ListView ItemsSource="{Binding Tasks}" MaxHeight="200"
                              Background="Transparent" Foreground="#c0c8d8"
                              BorderThickness="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="0,4"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Command}" FontWeight="Bold"
                                                   FontSize="11" Foreground="#e0e0e0"/>
                                        <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:HH:mm:ss}'}"
                                                   Foreground="#2a2e3a" FontSize="10"
                                                   Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Result}" Foreground="#00e676"
                                               FontFamily="Consolas" FontSize="10"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="280"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- CAMPAÃƒÆ’Ã¢â‚¬ËœAS: el modulo de phishing no forma parte de la
                         edicion Lite, asi que el bloque no se muestra. -->
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
